# Copy to .env and fill only the keys you explicitly authorize and need.
# Never commit .env or real API keys to version control.
# Note: External API keys are optional — PDF ingestion, RapidOCR, indexing,
# interactive Agent JSON import, QA, and Excel export run without external API keys.

# Google Gemini API (official google-genai SDK)
GEMINI_API_KEY=
VETCASE_GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible HTTP endpoint (OpenAI / DeepSeek / Qwen / vLLM / Ollama)
OPENAI_API_KEY=
OPENAI_BASE_URL=
VETCASE_OPENAI_MODEL=

# Optional runtime & cross-platform overrides
VETCASE_OCR_WORKERS=3
VETCASE_CJK_FONT=
VETCASE_CONFIG_DIR=
VETCASE_LOG_LEVEL=INFO
