# Copy to .env and fill only the keys you explicitly authorize and need.
# Never commit .env to version control.

# Google Gemini API (official google-genai SDK)
GEMINI_API_KEY=
VETCASE_GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible HTTP endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=
VETCASE_OPENAI_MODEL=

# Runtime overrides
VETCASE_OCR_WORKERS=3
VETCASE_LOG_LEVEL=INFO
